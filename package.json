{
  "name": "maayataan",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently --kill-others-on-fail \"astro dev\" \"wrangler dev --port 8787 --persist-to .wrangler/state\"",
    "dev:site": "astro dev",
    "dev:worker": "wrangler dev --port 8787 --persist-to .wrangler/state",
    "build": "astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && wrangler dev --port 8787 --persist-to .wrangler/state",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply maayataan-db --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply maayataan-db --remote",
    "db:verify:local": "wrangler d1 execute maayataan-db --local --persist-to .wrangler/state --command \"SELECT name FROM sqlite_schema WHERE type = 'table' ORDER BY name\"",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.112.0"
  }
}

# Same-origin in production. Use the Worker URL during local Astro development.
PUBLIC_API_BASE_URL=http://localhost:8787

# Cloudflare Turnstile public site key. The secret is configured with
# `wrangler secret put TURNSTILE_SECRET`, never in this file.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Local Worker secrets. Copy these to .dev.vars for development only.
# TURNSTILE_SECRET=your-turnstile-secret
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience
